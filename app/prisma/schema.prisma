generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url      = env("DATABASE_URL")
  // Migreringar körs via scripts/migrate.mjs, som väljer en direkt anslutning om en sådan finns.
}

// Alla belopp lagras i öre (heltal) för att undvika avrundningsfel.
// All bokföringsdata tillhör ett företag (companyId).

model User {
  id           Int          @id @default(autoincrement())
  email        String       @unique
  name         String
  passwordHash String
  theme        String       @default("system") // system | light | dark
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  sessions     Session[]
  oauthGrants  OAuthGrant[]
}

model Session {
  id              String   @id // sha256 av cookie-token
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeCompanyId Int?
  expiresAt       DateTime
  lastSeenAt      DateTime @default(now()) // för automatisk utloggning vid inaktivitet
  createdAt       DateTime @default(now())
}

model Membership {
  userId    Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role      String  @default("owner") // owner | full | read

  @@id([userId, companyId])
}

model Company {
  id          Int      @id @default(autoincrement())
  name        String
  orgNumber   String
  vatNumber   String   @default("")
  address     String   @default("")
  postalCode  String   @default("")
  city        String   @default("")
  email       String   @default("")
  bankgiro    String   @default("")
  invoiceDays Int      @default(30)

  // Bokföring och moms
  companyType      String @default("ab") // ab | ef | hb | ek
  accountingMethod String @default("invoice") // invoice (fakturametoden) | cash (kontantmetoden)
  vatPeriod        String @default("quarter") // month | quarter | year | none (ej momsregistrerad)
  euTrade          Boolean @default(false) // påverkar sista dag för helårsmoms
  fiscalStartMonth Int    @default(1) // startmånad för kommande räkenskapsår (1-12)
  phone       String   @default("")
  website     String   @default("")
  createdAt   DateTime @default(now())

  // Fakturadesign och betalningsuppgifter på fakturan
  invoiceTemplate String  @default("modern") // modern | klassisk | minimal | elegant
  invoiceColor    String  @default("#0071e3")
  invoiceFooter   String  @default("")
  logoStoredName  String?
  logoBlobUrl     String?
  logoMime        String?
  plusgiro        String  @default("")
  iban            String  @default("")
  bic             String  @default("")
  swishNumber     String  @default("")
  swishQr         Boolean @default(false)
  paymentLink     String  @default("")

  memberships   Membership[]
  accounts      Account[]
  verifications Verification[]
  templates     Template[]
  uploads       Upload[]
  customers     Customer[]
  articles      Article[]
  invoices      Invoice[]
  expenses      Expense[]
  vatPeriods    VatPeriod[]
  fiscalYears   FiscalYear[]
  bankTransactions BankTransaction[]
  invitations   Invitation[]
  oauthGrants   OAuthGrant[]
}

model FiscalYear {
  id            Int            @id @default(autoincrement())
  companyId     Int
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  start         DateTime
  end           DateTime
  closedAt      DateTime?
  // Verifikat som skapades av bokslutet (skatt, årets resultat, omföring), så att bokslutet kan ångras.
  closingVerificationIds Int[] @default([])
  verifications Verification[]

  @@unique([companyId, start])
}

model Account {
  id        Int                @id @default(autoincrement())
  companyId Int
  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number    Int
  name      String
  vatCode   String             @default("")
  active    Boolean            @default(true)
  lines     VerificationLine[]

  @@unique([companyId, number])
}

model Verification {
  id           Int           @id @default(autoincrement())
  companyId    Int
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  series       String        @default("V")
  fiscalYearId Int
  fiscalYear   FiscalYear    @relation(fields: [fiscalYearId], references: [id])
  number       Int
  date         DateTime
  description  String
  comment      String        @default("")
  createdAt    DateTime      @default(now())
  reversedById Int?          @unique
  reversedBy   Verification? @relation("Reversal", fields: [reversedById], references: [id])
  reverses     Verification? @relation("Reversal")
  lines        VerificationLine[]
  uploads      Upload[]
  invoices     Invoice[]     @relation("InvoiceVerification")
  invoicePays  Invoice[]     @relation("InvoicePayment")
  expenses     Expense[]     @relation("ExpenseVerification")
  expensePays  Expense[]     @relation("ExpensePayment")
  bankTransactions BankTransaction[]

  @@unique([companyId, series, fiscalYearId, number])
  @@index([companyId, date])
}

model VerificationLine {
  id             Int          @id @default(autoincrement())
  verificationId Int
  verification   Verification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  companyId      Int
  accountNumber  Int
  account        Account      @relation(fields: [companyId, accountNumber], references: [companyId, number], onDelete: Cascade) // konton raderas bara när hela företaget raderas
  debit          Int          @default(0)
  credit         Int          @default(0)
  text           String       @default("")

  @@index([companyId, accountNumber])
}

model Template {
  id          Int     @id @default(autoincrement())
  companyId   Int
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  category    String
  costAccount Int
  vatRate     Int
  vatAccount  Int?
  direction   String  @default("purchase") // purchase | sale | reverse
  keywords    String  @default("")
  description String  @default("") // förklaring som visas när man väljer mall
  usageCount  Int     @default(0) // för "Dina vanligaste mallar"
}

model Upload {
  id             Int           @id @default(autoincrement())
  companyId      Int
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fileName       String
  storedName     String        // lokalt filnamn eller sökväg i Vercel Blob
  blobUrl        String?
  mimeType       String
  size           Int           @default(0)
  date           DateTime?
  amount         Int?
  description    String        @default("")
  createdAt      DateTime      @default(now())
  // AI-avläsning av kvittot (OpenRouter): status, tolkad data och ev. felmeddelande
  aiStatus       String?       // done | error
  aiData         Json?
  aiError        String?
  verificationId Int?
  verification   Verification? @relation(fields: [verificationId], references: [id], onDelete: SetNull)
  expense        Expense?
}

model Customer {
  id         Int       @id @default(autoincrement())
  companyId  Int
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name       String
  orgNumber  String    @default("")
  email      String    @default("")
  address    String    @default("")
  postalCode String    @default("")
  city       String    @default("")
  reference  String    @default("")
  invoices   Invoice[]
}

model Article {
  id        Int     @id @default(autoincrement())
  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  unit      String  @default("st")
  price     Int
  vatRate   Int     @default(25)
  type      String  @default("service")
}

model Invoice {
  id                    Int           @id @default(autoincrement())
  companyId             Int
  company               Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number                Int?
  customerId            Int
  customer              Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade) // appen tillåter inte att kunder med fakturor tas bort
  date                  DateTime
  dueDate               DateTime
  status                String        @default("draft") // draft | sent | paid | credited
  ourReference          String        @default("")
  theirReference        String        @default("")
  notes                 String        @default("")
  paidDate              DateTime?
  createdAt             DateTime      @default(now())
  verificationId        Int?
  verification          Verification? @relation("InvoiceVerification", fields: [verificationId], references: [id])
  paymentVerificationId Int?
  paymentVerification   Verification? @relation("InvoicePayment", fields: [paymentVerificationId], references: [id])
  lines                 InvoiceLine[]

  @@unique([companyId, number])
}

model InvoiceLine {
  id          Int     @id @default(autoincrement())
  invoiceId   Int
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Float
  unit        String  @default("st")
  unitPrice   Int
  vatRate     Int     @default(25)
  type        String  @default("service")
}

model Expense {
  id                    Int           @id @default(autoincrement())
  companyId             Int
  company               Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee              String
  date                  DateTime
  description           String
  amount                Int
  vatRate               Int           @default(25)
  costAccount           Int
  status                String        @default("pending") // pending | booked | paid
  uploadId              Int?          @unique
  upload                Upload?       @relation(fields: [uploadId], references: [id])
  verificationId        Int?
  verification          Verification? @relation("ExpenseVerification", fields: [verificationId], references: [id])
  paymentVerificationId Int?
  paymentVerification   Verification? @relation("ExpensePayment", fields: [paymentVerificationId], references: [id])
  createdAt             DateTime      @default(now())
}

model VatPeriod {
  id             Int       @id @default(autoincrement())
  companyId      Int
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  start          DateTime
  end            DateTime
  lockedAt       DateTime?
  verificationId Int?

  @@unique([companyId, start, end])
}

// Transaktioner som importerats från bankens kontoutdrag (CSV) och som bokförs en och en.
model BankTransaction {
  id             Int           @id @default(autoincrement())
  companyId      Int
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bankAccount    Int           @default(1930)
  date           DateTime
  amount         Int // öre: positivt = insättning, negativt = uttag
  text           String
  reference      String        @default("")
  balance        Int?
  hash           String // för att känna igen rader som redan importerats
  matchKey       String        @default("") // normaliserad text, för att lära sig hur motparten bokförs
  status         String        @default("new") // new | booking | booked | ignored
  choice         Json? // hur raden bokfördes
  verificationId Int?
  verification   Verification? @relation(fields: [verificationId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())

  @@unique([companyId, hash])
  @@index([companyId, status, date])
}

// Inbjudan till ett företag (t.ex. revisor). Länken innehåller en token; bara dess hash sparas.
model Invitation {
  id          Int       @id @default(autoincrement())
  companyId   Int
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email       String
  role        String // full | read
  tokenHash   String    @unique
  invitedById Int?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([companyId])
}

// Kopplingar till Claude m.fl. via MCP (OAuth 2.1). Nycklar och koder sparas bara som hash.

// Klient som registrerat sig själv (dynamisk registrering) eller via ett metadatadokument (client_id är en URL).
model OAuthClient {
  id           String       @id // client_id
  name         String
  redirectUris String[]
  secretHash   String? // bara för klienter som valt autentisering med hemlighet
  metadataUrl  Boolean      @default(false) // client_id är en URL till klientens metadatadokument
  fetchedAt    DateTime?
  createdAt    DateTime     @default(now())
  codes        OAuthCode[]
  grants       OAuthGrant[]
}

// Engångskod från godkännandet, byts mot nycklar inom en minut (PKCE krävs).
model OAuthCode {
  codeHash      String      @id
  clientId      String
  client        OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId        Int
  companyId     Int
  scope         String
  redirectUri   String
  codeChallenge String
  resource      String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime    @default(now())
}

// En koppling: en användare har gett en klient åtkomst till ett företag. Återkallas från appen.
model OAuthGrant {
  id         Int          @id @default(autoincrement())
  clientId   String
  client     OAuthClient  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId     Int
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId  Int
  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  scope      String // read (senare: read write)
  resource   String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime     @default(now())
  tokens     OAuthToken[]

  @@index([companyId])
}

model OAuthToken {
  tokenHash String     @id
  grantId   Int
  grant     OAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  kind      String // access | refresh
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime   @default(now())

  @@index([grantId])
}
