# Postgres. På Vercel sätts dessa automatiskt av Neon-integrationen.
DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require"
# Valfri: direkt (opoolad) anslutning som används för migreringar om den finns.
DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/db?sslmode=require"
# Vercel Blob (privat store). Sätts automatiskt när Blob kopplas till projektet.
BLOB_READ_WRITE_TOKEN=

# AI-avläsning av kvitton via OpenRouter (valfritt). Utan nyckel fyller man i kvittouppgifter själv.
OPENROUTER_API_KEY=
# Valfri modell (standard: google/gemini-3.1-flash-lite, reserv: google/gemini-2.5-flash-lite).
# OPENROUTER_MODEL=

# Kvitton via e-post (Postmark Inbound). Webhook: https://inbound:<INBOUND_WEBHOOK_SECRET>@<din-app>/api/inbound/postmark
# INBOUND_ADDRESS="abc123@inbound.postmarkapp.com"
# INBOUND_WEBHOOK_SECRET="en-lang-slumpad-hemlighet"
